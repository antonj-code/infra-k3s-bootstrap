# ==============================================================================
# HashiCorp Vault Automation Environment Configuration
# Copy this file to .env.vault or export these variables in your shell / CI
# ==============================================================================

# Vault Load Balancer Endpoint (Self-signed TLS: SSL verification is skipped)
VAULT_ADDR="https://192.168.0.40:8200"
VAULT_SKIP_VERIFY="true"
VAULT_TOKEN=""

# Proxmox VE Host 1 (colossus.jnet.lan) Credentials
PVE_HOST_1_ENDPOINT="https://colossus.jnet.lan:8006/"
PVE_HOST_1_API_TOKEN=""
PVE_HOST_1_NODE_NAME="colossus"

# Proxmox VE Host 2 (guardian.jnet.lan) Credentials
PVE_HOST_2_ENDPOINT="https://guardian.jnet.lan:8006/"
PVE_HOST_2_API_TOKEN=""
PVE_HOST_2_NODE_NAME="guardian"

# Optional: GitLab REST API Integration for Automatic CI/CD Variable Sync
GITLAB_URL="https://gitbox.jnet.lan"
GITLAB_PROJECT="jnet-labs%2Finfra-k3s-bootstrap"
GITLAB_TOKEN=""
