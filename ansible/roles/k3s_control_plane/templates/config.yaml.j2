# K3s Control Plane Server Configuration
# Generated by Ansible for node: {{ inventory_hostname }}

{% if inventory_hostname == k3s_primary_control_plane and ((k3s_already_initialized.stat.exists | default(false)) or not (k3s_cluster_already_exists | default(false))) %}
cluster-init: true
{% else %}
server: "https://{{ k3s_join_target_address }}:{{ k3s_api_port }}"
{% endif %}


token: "{{ k3s_token }}"
node-ip: "{{ k3s_internal_ip }}"
node-external-ip: "{{ ansible_host }}"
advertise-address: "{{ k3s_internal_ip }}"
node-name: "{{ inventory_hostname }}"
flannel-iface: "{{ k3s_internal_interface | default(ansible_default_ipv4.interface) }}"
write-kubeconfig-mode: "{{ k3s_write_kubeconfig_mode }}"

# Network Configuration
cluster-cidr: "{{ k3s_cluster_cidr }}"
service-cidr: "{{ k3s_service_cidr }}"
cluster-dns: "{{ k3s_cluster_dns }}"
flannel-backend: "{{ k3s_flannel_backend }}"

# SELinux Integration
{% if k3s_selinux | default(true) %}
selinux: true
{% endif %}

# IPVS Proxy Configuration
kube-proxy-arg:
  - "proxy-mode={{ k3s_kube_proxy_mode }}"
{% if k3s_ipvs_strict_arp %}
  - "ipvs-strict-arp=true"
{% endif %}

# TLS Subject Alternative Names
tls-san:
  - "{{ kube_vip_address }}"
  - "{{ kube_vip_hostname }}"
{% for host in groups['k3s_control_plane'] %}
  - "{{ host }}"
  - "{{ hostvars[host]['ansible_host'] }}"
  - "{{ hostvars[host]['k3s_internal_ip'] }}"
{% endfor %}
{% for san in k3s_tls_sans %}
  - "{{ san }}"
{% endfor %}


# Kubernetes Node Labels (Role, Topology & Monitoring)
{% if k3s_node_labels is defined and k3s_node_labels | length > 0 %}
node-label:
{% for label in k3s_node_labels %}
  - "{{ label }}"
{% endfor %}
{% endif %}

# Kubernetes Node Taints
{% if k3s_node_taints is defined and k3s_node_taints | length > 0 %}
node-taint:
{% for taint in k3s_node_taints %}
  - "{{ taint }}"
{% endfor %}
{% endif %}

# Disabled Components
{% if k3s_disable_components is defined and k3s_disable_components | length > 0 %}
disable:
{% for item in k3s_disable_components %}
  - "{{ item }}"
{% endfor %}
{% endif %}


