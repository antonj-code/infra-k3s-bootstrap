# K3s Worker Node Configuration
# Generated by Ansible for node: {{ inventory_hostname }}

server: "https://{{ kube_vip_address | default(hostvars[k3s_primary_control_plane]['ansible_host']) }}:{{ k3s_api_port }}"
token: "{{ k3s_token }}"
{# node-ip only moves to the internal network (net1) once every node in the
   fleet has it - see k3s_common's fleet-readiness check. A node with an
   internal-only address is unroutable, not just unreachable, to any peer
   that hasn't been recreated with net1 yet (breaks flannel host-gw). #}
node-ip: "{{ k3s_internal_ip if k3s_internal_network_ready else ansible_host }}"
node-external-ip: "{{ ansible_host }}"
node-name: "{{ inventory_hostname }}"
{% if k3s_internal_network_ready %}
flannel-iface: "{{ k3s_internal_interface }}"
{% endif %}

# SELinux Integration
{% if k3s_selinux | default(true) %}
selinux: true
{% endif %}

# IPVS Proxy Configuration
kube-proxy-arg:
  - "proxy-mode={{ k3s_kube_proxy_mode }}"
{% if k3s_ipvs_strict_arp %}
  - "ipvs-strict-arp=true"
{% endif %}

# Kubernetes Node Labels (Role, Longhorn Storage, & Monitoring)
{% if k3s_node_labels is defined and k3s_node_labels | length > 0 %}
node-label:
{% for label in k3s_node_labels %}
  - "{{ label }}"
{% endfor %}
{% endif %}

